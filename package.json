{
  "name": "palworld-tcg",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @pal/web",
    "build": "npm run build -w @pal/web",
    "preview": "npm run preview -w @pal/web",
    "sync-cards": "tsx scripts/sync-cards.ts",
    "typecheck": "tsc -p packages/cards && tsc -p packages/engine && tsc -p packages/server && tsc -p apps/web",
    "test": "vitest run",
    "db:apply": "tsx scripts/db-apply.ts",
    "build:function": "tsx scripts/build-function.ts",
    "deploy:function": "tsx scripts/build-function.ts && npx -y supabase@2.122.0 functions deploy palworld-game --no-verify-jwt --use-api"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
